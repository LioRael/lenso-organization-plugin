{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "admin_callers",
    "database_url_secret",
    "schema"
  ],
  "properties": {
    "admin_callers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]+(?:/[A-Za-z0-9._:-]+)?$"
      }
    },
    "database_url_secret": {
      "type": "string"
    },
    "directory_callers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]+(?:/[A-Za-z0-9._:-]+)?$"
      },
      "default": []
    },
    "membership_admin_callers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]+(?:/[A-Za-z0-9._:-]+)?$"
      },
      "default": []
    },
    "schema": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
